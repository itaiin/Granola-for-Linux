+
+// db.updateHook(fn | null): fn(op, dbName, table, rowid) runs after every row
+// insert/update/delete, via sqlite3_update_hook(). Not part of upstream; Granola
+// ships this addition in its private build and its cache layer depends on it.
+NODE_METHOD(Database::JS_updateHook) {
+	UNWRAP_OR_RETURN(Database, db, info.This());
+	REQUIRE_DATABASE_OPEN(db);
+	if (info.Length() == 0 || info[0].IsNull() || info[0].IsUndefined()) {
+		sqlite3_update_hook(db->db_handle, NULL, NULL);
+		db->update_hook.Reset();
+		return info.Env().Undefined();
+	}
+	REQUIRE_ARGUMENT_FUNCTION(first, Napi::Function fn);
+	db->update_hook = Napi::Persistent(fn);
+	db->update_hook_env = info.Env();
+	sqlite3_update_hook(db->db_handle, UpdateHookCallback, db);
+	return info.Env().Undefined();
+}
+
+// Runs synchronously inside sqlite3_step() on the JS thread. An exception
+// thrown by the callback cannot propagate through SQLite, so it is cleared.
+void Database::UpdateHookCallback(void* self, int op, const char* db_name, const char* table, sqlite3_int64 rowid) {
+	Database* db = static_cast<Database*>(self);
+	if (db->update_hook.IsEmpty()) return;
+	Napi::Env env(db->update_hook_env);
+	Napi::HandleScope scope(env);
+	const char* op_name = op == SQLITE_INSERT ? "insert" : op == SQLITE_UPDATE ? "update" : "delete";
+	napi_value args[4] = {
+		StringFromUtf8(env, op_name, -1),
+		StringFromUtf8(env, db_name, -1),
+		StringFromUtf8(env, table, -1),
+		Napi::Number::New(env, static_cast<double>(rowid)),
+	};
+	SafeCall(env, db->update_hook.Value(), env.Undefined(), 4, args);
+	if (env.IsExceptionPending()) {
+		napi_value ignored;
+		napi_get_and_clear_last_exception(env, &ignored);
+	}
+}
